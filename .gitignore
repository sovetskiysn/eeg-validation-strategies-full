# python_project
python_project/.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
python_project/.env

# Dataset contents kept out of the repo, folders kept as empty placeholders
python_project/datasets/archive/*
!python_project/datasets/archive/.gitkeep
python_project/datasets/bids/*
!python_project/datasets/bids/.gitkeep
python_project/datasets/bids/*/derivatives/
python_project/datasets/prepared_cache/*

# MNE-BIDS-Pipeline HTML snapshots are reproducibility aids, not Git artifacts.
python_project/results/**/_preparation/
python_project/results/**/preparation_reports/

# latex_documents: build artifacts
# LaTeX Workshop is configured (.vscode/settings.json) to drop aux files here
latex_documents/**/.build/
latex_documents/**/*.aux
latex_documents/**/*.log
latex_documents/**/*.out
latex_documents/**/*.fls
latex_documents/**/*.fdb_latexmk
latex_documents/**/*.synctex.gz
latex_documents/**/*.bbl
latex_documents/**/*.blg
